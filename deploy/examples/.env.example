COMPOSE_PROJECT_NAME=dufs
# 使用 Phase 6 本地构建的不可变风格镜像标签；不要使用 latest。
DUFS_IMAGE=dufs:0.46.0-custom-v1-<git-short-sha>
DUFS_HOST_IP=127.0.0.1
DUFS_PORT=5000
DUFS_DATA_DIR=/absolute/path/to/dufs/data
DUFS_CONFIG_DIR=/absolute/path/to/dufs/config
DUFS_ASSETS_DIR=/absolute/path/to/dufs/assets
DUFS_LOGS_DIR=/absolute/path/to/dufs/logs
DUFS_RESTART_POLICY=unless-stopped
# 填入运行宿主机维护用户的实际 numeric UID/GID；不要假定为 1000。
DUFS_UID=<HOST_NUMERIC_UID>
DUFS_GID=<HOST_NUMERIC_GID>
# 仅在 runtime 使用 SHA-512 crypt 规则。外层单引号必须保留，使 Compose 不展开 hash 中的 $。
DUFS_ADMIN_AUTH='admin:<SET_SHA512_CRYPT_HASH>@/:rw'
